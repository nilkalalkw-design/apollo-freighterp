{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/app.js",
      "destination": "/erp/app.js"
    },
    {
      "source": "/app-runtime.js",
      "destination": "/erp/app-runtime.js"
    },
    {
      "source": "/config.js",
      "destination": "/erp/config.js"
    },
    {
      "source": "/styles.css",
      "destination": "/erp/styles.css"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/erp/assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/erp/index.html"
    }
  ],
  "headers": [
    {
      "source": "/app.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/app-runtime.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/config.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/styles.css",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
