{
  "name": "apollo-freight-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "start:render": "npm run start",
    "start:railway": "npm run migrate && node src/scripts/seed-if-enabled.js && npm run start",
    "setup:prod": "npm run migrate && npm run seed",
    "build": "node -e \"console.log('server build step complete')\"",
    "seed": "node src/scripts/seed.js",
    "migrate": "node src/scripts/migrate.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.0"
  }
}
