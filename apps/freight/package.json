{
  "name": "apollo-freight-solutions-platform",
  "private": true,
  "version": "0.1.0",
  "author": "Apollo-Freight Solutions",
  "description": "Apollo-Freight Solutions transport management desktop and web platform",
  "main": "desktop/main.cjs",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm --workspace client run dev",
    "dev:server": "npm --workspace server run dev",
    "build": "npm --workspace client run build && npm --workspace server run build",
    "start": "npm --workspace server run start",
    "start:render": "npm --workspace server run start:render",
    "start:railway": "npm --workspace server run migrate && npm --workspace server run start",
    "setup:prod": "npm --workspace server run migrate && npm --workspace server run seed",
    "desktop:dev": "electron .",
    "desktop:dist": "electron-builder --win nsis",
    "mobile:build": "npm --workspace client run build",
    "mobile:sync": "npm run mobile:build && npx cap sync",
    "mobile:copy": "npm run mobile:build && npx cap copy",
    "mobile:add:android": "npx cap add android",
    "mobile:add:ios": "npx cap add ios",
    "mobile:open:android": "npx cap open android",
    "mobile:open:ios": "npx cap open ios"
  },
  "build": {
    "appId": "com.apollofreight.solutions",
    "productName": "Apollo-Freight Solutions",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "electron": "^37.1.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4"
  }
}
