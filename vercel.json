{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/erp",
      "destination": "/apps/erp/web/index.html"
    },
    {
      "source": "/erp/",
      "destination": "/apps/erp/web/index.html"
    },
    {
      "source": "/erp/(.*)",
      "destination": "/apps/erp/web/$1"
    },
    {
      "source": "/freight",
      "destination": "/apps/freight/client/dist/index.html"
    },
    {
      "source": "/freight/",
      "destination": "/apps/freight/client/dist/index.html"
    },
    {
      "source": "/freight/(.*)",
      "destination": "/apps/freight/client/dist/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
