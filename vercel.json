{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/erp",
      "destination": "/erp/index.html"
    },
    {
      "source": "/erp/",
      "destination": "/erp/index.html"
    },
    {
      "source": "/erp/(.*)",
      "destination": "/erp/$1"
    },
    {
      "source": "/freight",
      "destination": "/freight/index.html"
    },
    {
      "source": "/freight/",
      "destination": "/freight/index.html"
    },
    {
      "source": "/freight/(.*)",
      "destination": "/freight/$1"
    },
    {
      "source": "/freight-api/(.*)",
      "destination": "https://apollo-freight-pst1.onrender.com/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
