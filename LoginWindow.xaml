<Window x:Class="ApolloFreightERP.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="APOLLO FREIGHT SOLUTIONS - Login"
        Height="610"
        Width="980"
        MinHeight="560"
        MinWidth="900"
        ResizeMode="NoResize"
        Background="#F4F6F8"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#12202F">
            <StackPanel Margin="38" VerticalAlignment="Center">
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="82"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="AfsFallback"
                            Width="70"
                            Height="70"
                            CornerRadius="10"
                            Background="#F58220"
                            HorizontalAlignment="Left">
                        <TextBlock Text="A F S"
                                   Foreground="White"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <Image x:Name="LogoImage"
                           Width="70"
                           Height="70"
                           Stretch="Uniform"
                           Visibility="Collapsed"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="24" FontWeight="Bold" TextWrapping="Wrap">
                        <TextBlock.Inlines><Run Text="A" Foreground="#F58220"/><Run Text="POLLO " Foreground="White"/><Run Text="F" Foreground="#F58220"/><Run Text="REIGHT " Foreground="White"/><Run Text="S" Foreground="#F58220"/><Run Text="OLUTIONS" Foreground="White"/></TextBlock.Inlines>
                    </TextBlock>
                </Grid>
                <TextBlock Text="We Bring Continents closer..."
                           Foreground="#AFC3D8"
                           FontSize="17"
                           FontStyle="Italic"
                           TextWrapping="Wrap"/>
                <Border Height="1" Background="#2C4055" Margin="0,28,0,26"/>
                <TextBlock Text="Cargo Shipments ERP"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Land freight consolidation, tariffs, POD, documents, billing, and audit controls."
                           Foreground="#AFC3D8"
                           FontSize="14"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1"
                Background="White"
                BorderBrush="#DDE4EC"
                BorderThickness="1"
                CornerRadius="8"
                Padding="42"
                Margin="42"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Sign in"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#16202A"/>
                <TextBlock Text="Use temporary admin access for testing."
                           FontSize="14"
                           Foreground="#687582"
                           Margin="0,6,0,28"/>

                <TextBlock Text="User name" Foreground="#5F6D7A" FontSize="13"/>
                <TextBox x:Name="UserNameBox"
                         Text="admin"
                         Height="40"
                         Padding="10"
                         BorderBrush="#C7D2DE"
                         Margin="0,4,0,14"/>

                <TextBlock Text="Password" Foreground="#5F6D7A" FontSize="13"/>
                <PasswordBox x:Name="PasswordBox"
                             Password="admin123"
                             Height="40"
                             Padding="10"
                             BorderBrush="#C7D2DE"
                             Margin="0,4,0,8"/>

                <TextBlock x:Name="LoginMessage"
                           Foreground="#8E3B46"
                           FontSize="13"
                           Margin="0,0,0,12"/>

                <Button Content="Login"
                        Height="42"
                        Background="#F58220"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Click="Login_Click"/>

                <Expander Header="Reset password by email"
                          Margin="0,22,0,0"
                          Foreground="#16202A">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="Email address" Foreground="#5F6D7A" FontSize="13"/>
                        <TextBox x:Name="ResetEmailBox"
                                 Height="38"
                                 Padding="10"
                                 BorderBrush="#C7D2DE"
                                 Margin="0,4,0,10"/>
                        <Button Content="Send Reset Link"
                                Height="38"
                                Background="#12202F"
                                Foreground="White"
                                BorderThickness="0"
                                Click="ResetPassword_Click"/>
                        <TextBlock Text="For the live server version, this will send a real email reset link using SMTP or Microsoft 365."
                                   TextWrapping="Wrap"
                                   Foreground="#687582"
                                   FontSize="12"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Expander>
                <TextBlock Margin="0,28,0,0"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="#687582">
                    <Run Text="Designed by ApolloIT | Copyright © 2026 "/>
                    <Run Text="Apollo Freight Solutions" Foreground="#F58220" FontWeight="SemiBold"/>
                    <Run Text=". All rights reserved."/>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
