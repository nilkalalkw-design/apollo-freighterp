<Window x:Class="ApolloFreightERP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="APOLLO FREIGHT SOLUTIONS - Cargo Shipments ERP"
        Height="860"
        Width="1360"
        MinHeight="760"
        MinWidth="1180"
        Background="#F4F6F8"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#12202F">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="18,22,18,16">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="AfsFallback"
                                Width="50"
                                Height="50"
                                CornerRadius="8"
                                Background="#F58220"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top">
                            <TextBlock Text="A F S"
                                       Foreground="White"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <Image x:Name="LogoImage"
                               Width="50"
                               Height="50"
                               Stretch="Uniform"
                               Visibility="Collapsed"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="17" FontWeight="Bold" TextWrapping="Wrap">
                            <TextBlock.Inlines><Run Text="A" Foreground="#F58220"/><Run Text="POLLO " Foreground="White"/><Run Text="F" Foreground="#F58220"/><Run Text="REIGHT " Foreground="White"/><Run Text="S" Foreground="#F58220"/><Run Text="OLUTIONS" Foreground="White"/></TextBlock.Inlines>
                        </TextBlock>
                    </Grid>
                    <TextBlock Text="We Bring Continents closer..."
                               Foreground="#AFC3D8"
                               FontSize="12"
                               FontStyle="Italic"
                               TextWrapping="Wrap"/>
                    <Border Height="1" Background="#2C4055" Margin="0,18,0,0"/>
                </StackPanel>
                <ListBox x:Name="NavigationList"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="#D9E3EE"
                         SelectionChanged="NavigationList_SelectionChanged">
                    <ListBox.Resources>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="18,11"/>
                            <Setter Property="Margin" Value="10,2"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Foreground" Value="#D9E3EE"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder"
                                                Background="Transparent"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#F58220"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#20354A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Resources>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="128"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#DDE4EC" BorderThickness="0,0,0,1">
                <Grid Margin="24,10,24,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="13" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock.Inlines><Run Text="A" Foreground="#F58220"/><Run Text="POLLO " Foreground="#16202A"/><Run Text="F" Foreground="#F58220"/><Run Text="REIGHT " Foreground="#16202A"/><Run Text="S" Foreground="#F58220"/><Run Text="OLUTIONS" Foreground="#16202A"/></TextBlock.Inlines>
                            </TextBlock>
                            <TextBlock Text="We Bring Continents closer..."
                                       FontSize="13"
                                       FontStyle="Italic"
                                       Foreground="#687582"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="24" FontWeight="SemiBold" Foreground="#16202A" Margin="0,4,0,0"/>
                        <TextBlock x:Name="PageSubtitle" Text="Live operational summary for land freight consolidation" FontSize="13" Foreground="#687582" Margin="0,3,0,0"/>
                        <TextBlock x:Name="UserContextText" Text="User: admin | Branch: Both" FontSize="12" Foreground="#8A97A5" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBox x:Name="GlobalSearchBox"
                             Grid.Column="1"
                             Height="38"
                             VerticalAlignment="Center"
                             Padding="12,8"
                             FontSize="14"
                             BorderBrush="#C7D2DE"
                             Text="Search shipment, waybill, invoice, customer"/>
                    <Button Grid.Column="2"
                            Content="New Shipment"
                            Height="38"
                            Margin="14,0,0,0"
                            Padding="18,0"
                            VerticalAlignment="Center"
                            Background="#F58220"
                            Foreground="White"
                            BorderThickness="0"
                            Click="CreateShipment_Click"/>
                    <Button Grid.Column="3"
                            Content="Logout"
                            Height="38"
                            Margin="10,0,0,0"
                            Padding="18,0"
                            VerticalAlignment="Center"
                            Background="#12202F"
                            Foreground="White"
                            BorderThickness="0"
                            Click="Logout_Click"/>

                    <Grid x:Name="HeaderDateFilterPanel" Grid.Row="1" Grid.ColumnSpan="4" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Date Range Search"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#425E7B"
                                   Margin="0,0,10,0"/>
                        <DatePicker x:Name="FromDateFilter"
                                    Grid.Column="1"
                                    Height="34"
                                    BorderBrush="#C7D2DE"
                                    Margin="0,0,10,0"/>
                        <DatePicker x:Name="ToDateFilter"
                                    Grid.Column="2"
                                    Height="34"
                                    BorderBrush="#C7D2DE"
                                    Margin="0,0,10,0"/>
                        <Button Grid.Column="3"
                                Content="Search"
                                Height="34"
                                Padding="18,0"
                                Margin="0,0,10,0"
                                Background="#425E7B"
                                Foreground="White"
                                BorderThickness="0"
                                Click="ApplyDateFilter_Click"/>
                        <Button Grid.Column="4"
                                Content="Reset"
                                Height="34"
                                Padding="18,0"
                                Background="#EEF3F8"
                                Foreground="#16202A"
                                BorderBrush="#C7D2DE"
                                Click="ClearDateFilter_Click"/>
                        <TextBlock x:Name="DateFilterStatusText"
                                   Grid.Column="5"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#687582"
                                   FontSize="12"/>
                    </Grid>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ContentControl x:Name="MainContent" Margin="24"/>
            </ScrollViewer>

            <Border Grid.Row="2" Background="White" BorderBrush="#DDE4EC" BorderThickness="0,1,0,0">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="#687582">
                    <Run Text="Designed by ApolloIT | Copyright © 2026 "/>
                    <Run Text="Apollo Freight Solutions" Foreground="#F58220" FontWeight="SemiBold"/>
                    <Run Text=". All rights reserved."/>
                </TextBlock>
            </Border>
        </Grid>
    </Grid>
</Window>
